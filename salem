    function parseAnswers(inputString) {
  const answers = {};
  
  // Matches digits followed by a colon, optional spaces, and a single letter or word
  // 'g' finds all matches globally throughout the string
  const regex = /(\d+):\s*([A-Za-z]+)/g;
  let match;

  while ((match = regex.exec(inputString)) !== null) {
    const questionNumber = parseInt(match[1], 10);
    const answerValue = match[2];
    answers[questionNumber] = answerValue;
  }

  return answers;
};

